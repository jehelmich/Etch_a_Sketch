# ---------------------------------------------------------------------------
# Quartus Prime / Qsys build output
#
# Everything below is regenerated by `quartus_sh --flow compile` or by
# re-generating the Qsys systems. Only the .qpf/.qsf project files, the .qsys
# system descriptions, the _hw.tcl component descriptions and the HDL sources
# belong in version control.
# ---------------------------------------------------------------------------
db/
incremental_db/
output_files/
simulation/
greybox_tmp/
hc_output/
.qsys_edit/
hps_isw_handoff/
*.qws
*.sopcinfo
*.sof
*.pof
*.rbf
*.jic
*.qdf
*.rpt
*.smsg
*.summary
*.pin
*.jdi
*.sld
*.done
*.cdf
*.qar
*.qarlog

# Qsys writes each generated system into a directory named after the .qsys
# file; those hold nothing that is not derived from the .qsys itself.
/hardware/quartus/clarvi_soc/
/hardware/quartus/hex_led/

# SignalTap captures
*.stp
*.stp.rpt

# ---------------------------------------------------------------------------
# Bare-metal software build output
# ---------------------------------------------------------------------------
/software/build/
*.o
*.elf
*.dump
*.bin
*.hex
*.mif

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
*~
*.bak
*.orig
*.swp
.DS_Store
